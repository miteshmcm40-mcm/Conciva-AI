# NIXXY — environment template.
# Copy to `.env` and fill in real values. The real `.env` is gitignored and is
# NEVER committed. Do not put credentials in this file.

# --- Postgres ---------------------------------------------------------------
PG_HOST=
PG_PORT=
PG_DB=
PG_USER=
PG_PASSWORD=

# --- App --------------------------------------------------------------------
# Backend API port. Must match the proxy target in vite.config.js
# (currently hardcoded to http://localhost:4000) — if you change this,
# update vite.config.js's API_TARGET to match, or the frontend's /api
# calls will silently fail to connect.
PORT=4000
# Signs both the Postgres session cookie machinery AND the stateless demo
# login tokens (server/demoAuth.js). Falls back to an insecure hardcoded
# value if unset — MUST be set on any real deployment (openssl rand -hex 32).
SESSION_SECRET=
# Public URL the app/Twilio callbacks resolve to (frontend host:port).
PUBLIC_BASE_URL=

# --- Twilio -----------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_DEFAULT_NUMBER=
# Twilio SIP IPs (for LiveKit trunk allowlist)
SIP_GATEWAY_IP=

# --- MCP / Dashboard --------------------------------------------------------
MCP_URL=
MCP_TOKEN=
DASHBOARD_BASE_URL=
DASHBOARD_EMAIL=
DASHBOARD_PASSWORD=

# --- Email (SMTP) -------------------------------------------------------
# Used for transactional email, including the signup OTP codes
# (server/mail.js, server/index.js's /api/auth/send-otp etc). Without these
# set, the OTP endpoints still work but log the code to the server console
# and return it as `devOtp` in the response instead of emailing it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Defaults to "Voice Portal <SMTP_USER>" if left blank.
SMTP_FROM=
# Auto-picked from SMTP_PORT (true for 465) — set explicitly to override.
SMTP_SECURE=

# Reseller scoping — which reseller portal this deployment represents.
RESELLER_PORTAL=

# --- Numbers ----------------------------------------------------------------
NUMBER_PRICE_MARKUP=
NUMBER_PROVIDER=
MANUAL_NUMBERS=

# --- AI keys ----------------------------------------------------------------
XAI_API_KEY=
OPENAI_API_KEY=
TTS_PREVIEW_TEXT=
GOOGLE_API_KEY=
GOOGLE_TTS_API_KEY=

# --- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=